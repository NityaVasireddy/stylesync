# Backend
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
AI_PROVIDER=mock

# Optional managed persistence. Keep STORAGE_PROVIDER=json for a local demo.
# To use Supabase, set STORAGE_PROVIDER=supabase and provide real credentials.
# When configured, wardrobe/profile/history/ratings are stored in Supabase.
STORAGE_PROVIDER=json
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
